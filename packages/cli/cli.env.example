# CLI config (fxrt). Copy to ~/.config/fxrt/cli.env ($XDG_CONFIG_HOME/fxrt/cli.env),
# or pass --config <file> / set FXRT_CONFIG. Environment variables override this file.
# The CLI never reads a .env from the folder it runs in.

# Server to connect to (default: ws://127.0.0.1:7420).
FXRT_SERVER_URL=ws://127.0.0.1:7420

# trace | debug | info | warning | error | fatal (default: info)
FXRT_LOG_LEVEL=info

# Log file, absolute path.
# Default: ~/Library/Logs/fxrt/cli.log (macOS), $XDG_STATE_HOME/fxrt/cli.log (Linux).
# FXRT_STATE_DIR moves the default folder.
FXRT_CLI_LOG=
