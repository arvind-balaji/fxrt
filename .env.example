# Server config (fxrtd). Copy to .env in the folder you run the server from.
# The CLI does not read this file: see packages/cli/cli.env.example.

# Bind address (default: 127.0.0.1:7420). Bind to localhost, an SSH tunnel, or a private network only:
# M1 has no authentication or encryption.
FXRT_HOST=127.0.0.1
FXRT_PORT=7420

# trace | debug | info | warning | error | fatal (default: info)
FXRT_LOG_LEVEL=info

# Not read yet.
# Model (OpenRouter). Pin an exact model ID.
OPENROUTER_API_KEY=
FXRT_MODEL=
# Journal (SQLite). Absolute path.
FXRT_JOURNAL_PATH=
