# Copy to .env. Bun loads .env automatically.

# Model (OpenRouter). Pin an exact model ID.
OPENROUTER_API_KEY=
FXRT_MODEL=

# Server address. Bind to localhost, an SSH tunnel, or a private network only:
# M1 has no authentication or encryption.
FXRT_HOST=127.0.0.1
FXRT_PORT=7420

# Logging: trace | debug | info | warning | error | fatal
FXRT_LOG_LEVEL=info
# CLI log file (default ~/.fxrt/cli.log). Ink owns stdout; use --verbose for stderr.
FXRT_CLI_LOG=

# Journal (SQLite)
FXRT_JOURNAL_PATH=./data/journal.sqlite
